db.getSiblingDB("admin").auth(process.env.MONGODB_ROOT_USER, process.env.MONGODB_ROOT_PASSWORD);

{{ range .Vars.app.users }}
{
  const database = db.getSiblingDB({{ quote .database }});
  const options = {pwd: {{ quote .password }}, roles: {{ toJSON .roles }}};

  if (database.getUser({{ quote .name }})) {
    database.updateUser({{ quote .name }}, options);
  } else {
    database.createUser({user: {{ quote .name }}, ...options});
  }
}
{{ end }}
