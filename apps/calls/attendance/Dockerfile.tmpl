FROM eclipse-temurin:25-jdk AS builder

RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*

WORKDIR /src

RUN git clone {{ quote .Vars.build.repository }} . \
    && git checkout {{ quote .Vars.build.tag }}

WORKDIR /src/plugin-attendance/backend

RUN ./gradlew :assembly:bootJar --no-daemon

FROM eclipse-temurin:25-jre

RUN apt-get update && apt-get install -y --no-install-recommends wget && rm -rf /var/lib/apt/lists/*

WORKDIR /app

LABEL org.opencontainers.image.source={{ quote .Vars.build.repository }} \
      org.opencontainers.image.revision={{ quote .Vars.build.tag }}

COPY --from=builder /src/plugin-attendance/backend/assembly/build/libs/plugin-attendance.jar application.jar

USER 1000:1000

EXPOSE 8081

ENTRYPOINT ["java", "-jar", "/app/application.jar"]
