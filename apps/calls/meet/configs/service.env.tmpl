{{- range $name, $value := .Vars.app.environment }}
{{ $name }}={{ quote $value }}
{{- end }}
{{- with .Vars.app.mongodb }}
MEET_MONGO_URI={{ printf "%q" (printf "mongodb://%s:%s@%s:%v/%s?authSource=%s&replicaSet=%s&readPreference=primaryPreferred" .username .password .host .port .database .database .replica_set) }}
{{- end }}
