FROM eclipse-temurin:21-jdk AS jdk

FROM postgres:17.7 AS builder
COPY --from=jdk /opt/java/openjdk /opt/java/openjdk
ENV JAVA_HOME=/opt/java/openjdk
ENV PATH="${JAVA_HOME}/bin:${PATH}"
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /src
RUN git clone {{ quote .Vars.build.repository }} . \
    && git checkout {{ quote .Vars.build.tag }}

# jOOQ needs a disposable schema during compilation; it is not used at runtime.
RUN su postgres -s /bin/sh -c 'initdb -D /tmp/jooq-postgres -A trust -U postgres' \
    && su postgres -s /bin/sh -c 'pg_ctl -D /tmp/jooq-postgres -l /tmp/jooq-postgres.log -o "-h 127.0.0.1" start' \
    && createdb -h 127.0.0.1 -U postgres plugin_manager_build \
    && JOOQ_JDBC_URL=jdbc:postgresql://127.0.0.1:5432/plugin_manager_build ./gradlew assemble --no-daemon --max-workers=1 \
        -Dorg.gradle.jvmargs="-Xmx768m -XX:MaxMetaspaceSize=384m" \
        -Pkotlin.compiler.execution.strategy=in-process \
    && su postgres -s /bin/sh -c 'pg_ctl -D /tmp/jooq-postgres stop'

FROM eclipse-temurin:21-jre
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /src/build/quarkus-app/ ./
USER 1000:1000
EXPOSE 8080 9000
ENTRYPOINT ["java", "-jar", "quarkus-run.jar"]
