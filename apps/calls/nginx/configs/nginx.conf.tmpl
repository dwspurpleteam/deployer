map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

resolver {{ .Vars.app.resolver }} valid={{ .Vars.app.resolver_valid }} ipv6=off;

{{ range $name, $address := get .Vars.app "upstreams" }}
upstream {{ $name }} {
  zone {{ $name }} 64k;
  server {{ $address }} resolve;
}
{{ end }}

{{ if .Vars.app.streamapi.enabled }}
map $http_x_call_id $streamapi_call_key {
  '' $request_id;
  default $http_x_call_id;
}

upstream streamapi {
  zone streamapi 64k;
  server {{ .Vars.app.streamapi.http.upstream }} resolve;
  keepalive {{ .Vars.app.streamapi.http.keepalive }};
  keepalive_timeout {{ .Vars.app.streamapi.http.keepalive_timeout }};
}

upstream streamapi_grpc {
  zone streamapi_grpc 64k;
  hash {{ .Vars.app.streamapi.grpc.hash }};
  server {{ .Vars.app.streamapi.grpc.upstream }} resolve;
}
{{ end }}

server {
  listen {{ .Vars.app.listen }};
  client_max_body_size {{ .Vars.app.max_body_size }};
  add_header X-Composer-Environment {{ quote .Env }} always;
  absolute_redirect {{ .Vars.app.absolute_redirect }};

  location = /healthz { return 200 'ok\n'; }

{{ with get .Vars.app "redirect" }}
  location = / { return 302 {{ . }}; }
{{ end }}

{{ range $path, $upstream := get .Vars.app "routes" }}
  location {{ $path }} {
    proxy_pass http://{{ $upstream }};
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;

    proxy_read_timeout {{ $.Vars.app.proxy_timeout }};
  }
{{ end }}

  location / { return 503; }
}

{{ if .Vars.app.streamapi.enabled }}
server {
  listen {{ .Vars.app.streamapi.http.listen }};
  client_max_body_size {{ $.Vars.app.max_body_size }};
  proxy_http_version 1.1;
  proxy_set_header Connection '';

  location = /webhooks/livekit {
    proxy_pass http://streamapi;
    proxy_connect_timeout {{ .Vars.app.streamapi.http.webhook.connect_timeout }};
    proxy_send_timeout {{ .Vars.app.streamapi.http.webhook.send_timeout }};
    proxy_read_timeout {{ .Vars.app.streamapi.http.webhook.read_timeout }};
    proxy_next_upstream error timeout invalid_header http_500 http_502 http_503 http_504 non_idempotent;
    proxy_next_upstream_tries {{ .Vars.app.streamapi.http.webhook.attempts }};
    proxy_next_upstream_timeout {{ .Vars.app.streamapi.http.webhook.retry_timeout }};
  }

  location / {
    proxy_pass http://streamapi;
    proxy_read_timeout {{ $.Vars.app.proxy_timeout }};
  }
}

server {
  listen {{ .Vars.app.streamapi.grpc.listen }};
  http2 on;
  http2_max_concurrent_streams {{ .Vars.app.streamapi.grpc.max_concurrent_streams }};

  location / {
    grpc_pass grpc://streamapi_grpc;
    grpc_connect_timeout {{ .Vars.app.streamapi.grpc.connect_timeout }};
    grpc_read_timeout {{ .Vars.app.streamapi.grpc.read_timeout }};
    grpc_send_timeout {{ .Vars.app.streamapi.grpc.send_timeout }};
  }
}
{{ end }}
